# Copie para .env e preencha. NUNCA commite o .env.

# --- Shopee Affiliate Open API (painel de afiliado > Open API) ---
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Palavras que o robô sorteia para buscar ofertas (separadas por vírgula)
SHOPEE_PALAVRAS=achadinhos,cozinha,casa,beleza,maquiagem,eletronicos,fone bluetooth,organizador,pet,infantil
# Etiqueta que aparece no relatório da Shopee para saber que a venda veio do WhatsApp
SHOPEE_SUB_ID=whatsapp

# --- Evolution API (WhatsApp) ---
# Invente uma senha longa; a mesma vai para o docker-compose
EVOLUTION_API_KEY=troque-por-uma-senha-longa
EVOLUTION_URL=http://evolution:8080
EVOLUTION_INSTANCIA=robo
POSTGRES_PASSWORD=troque-esta-senha-tambem
# IDs dos grupos (terminam em @g.us), separados por vírgula. Veja com: python -m robo grupos
GRUPOS=

# --- Filtros ---
DESCONTO_MINIMO=40
PRECO_MINIMO=10
PRECO_MAXIMO=300
NOTA_MINIMA=4.5
VENDAS_MINIMAS=50
NAO_REPETIR_DIAS=7

# --- Ritmo ---
INTERVALO_MINUTOS=15
HORA_INICIO=8
HORA_FIM=23
FUSO=America/Cuiaba
PAUSA_ENTRE_GRUPOS=20
# Hora do resumo "Top 5 achadinhos de hoje" (0 desliga)
HORA_TOP=20
